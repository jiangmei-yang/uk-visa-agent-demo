# Offline demo works without any secrets.
VISA_AGENT_DATABASE=data/visa_agent.db
VISA_AGENT_OUTPUT_DIR=demo_output
VISA_AGENT_POLICY_PATH=knowledge/uk_standard_visitor_2026-02-25.yaml
VISA_AGENT_RETENTION_DAYS=30

# Optional live adapters. Never commit real credentials.
# These are environment variable examples, not an automatically loaded .env configuration.
# Export required variables into the process that runs the worker/webhook.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=.secrets/deepseek_api_key.txt
LLM_PROVIDER=openai
LLM_MODEL=
GMAIL_CREDENTIALS_FILE=.secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=.secrets/gmail_token.json
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_CALLBACK_PUBLIC_URL=
